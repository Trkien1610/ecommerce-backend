# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG commit file .env.

# Django
SECRET_KEY=change-me

# Database (PostgreSQL sẽ chạy bằng Docker ở Task 2.3)
DATABASE_URL=postgres://ecommerce:ecommerce@localhost:5432/ecommerce

# CORS: domain Frontend được phép gọi API, cách nhau bằng dấu phẩy
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Chỉ cần khi chạy production (config.settings.prod)
# ALLOWED_HOSTS=api.myshop.vn
# CSRF_TRUSTED_ORIGINS=https://api.myshop.vn